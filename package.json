{
  "name": "petus-launcher",
  "version": "1.1.2",
  "description": "PetusGDPS launcher — Petus ID login, auto-update, boots Geometry Dash authenticated.",
  "main": "src/main/main.js",
  "author": "Dimsk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "rocks.goonhost.petus.launcher",
    "productName": "PetusLauncher",
    "artifactName": "PetusLauncher-Setup.${ext}",
    "protocols": [
      {
        "name": "PetusLauncher",
        "schemes": ["petus-launcher"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
